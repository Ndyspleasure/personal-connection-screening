# =============================================================================
# Personal Connection Screening System — environment template
# Copy to `.env` for local dev. NEVER commit real secrets (see .gitignore).
# Only variables prefixed NEXT_PUBLIC_* are exposed to the browser bundle.
# Everything else is SERVER-ONLY (see packages/config).
# =============================================================================

# --- Database (System of Record: PostgreSQL / Supabase) ----------------------
# Local dev via docker: postgres://postgres:postgres@localhost:5432/pcs
# Production: use the Supabase *pooled* connection string (server-side only).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/pcs"

# --- Supabase (Admin Auth + optional Storage) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key BYPASSES RLS — server-only, never exposed to any client.
SUPABASE_SERVICE_ROLE_KEY=""
# Email of the first admin OWNER, self-provisioned on first sign-in while the
# admin allow-list is still empty. Later admins are managed in the CMS.
ADMIN_BOOTSTRAP_EMAIL=""

# --- Public session security -------------------------------------------------
# 32+ byte random secret; used for token fingerprinting salt / signing.
SESSION_SECRET=""
# Verification reference signing/derivation secret (server-only).
VERIFICATION_SECRET=""

# --- Rate limiting (Upstash Redis — enabled from MVP) ------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Cron / maintenance ------------------------------------------------------
CRON_SECRET=""

# --- App environment / origins ----------------------------------------------
# development | preview | production
APP_ENV="development"
# Comma-separated allowed origins for CSRF/origin validation of state changes.
PUBLIC_ALLOWED_ORIGINS="http://localhost:3000"
ADMIN_ALLOWED_ORIGINS="http://localhost:3001"
